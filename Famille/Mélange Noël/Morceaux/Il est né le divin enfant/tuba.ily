tuba = \relative do' {
  % p1
  sol4 sol sol sol8 sol
  sol4 sol sol2
  sol4 sol8 sol sol4 sol8 sol
  fad4 sol re re-.
  
  sol4 sol sol sol8 sol
  sol4 sol sol2
  sol4 sol sol do,8 do
  re4 re sol,2
  
  %p2
  R1 * 2
  si'4 la si8 sol do si
  la4 sol re re
  
  R1 *2
  sol4 la si do8 si
  la4 sol re2
}