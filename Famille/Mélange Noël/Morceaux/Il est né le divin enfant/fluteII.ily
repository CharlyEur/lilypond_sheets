fluteII = \relative do' {
  \repeat volta 2
  {
    re4 sol re'8 mi re si
    do4. la8 si2
    mi,4 mi8 fad sol4 la8 si
    do8 re do si la sol fad4
    
    re4 sol re'8 mi si mi
    re4. sol,8 si2
    sol'4 fad8 mi re4 mi8 mi
    do8 si la do si2
    
    %p2
    si4 do re do8 si
    do4 mi re2
    si4 do re mi8 re
    do4 si si la
    si4 do re do8 si 
    do4 mi re2
    si4 do re mi8 re
    do4 si la2
  }
    
  \bar "|."
}