trompetteI = \relative do''' {
  sol4 fad mi re
  re4. re8 re( do si4)
  re4 re sol, sol8( la)
  la4 la8( re) re4 mi8 fad
  sol4( fad mi) re
  re4. re8 re( do si4)
  si4 la la8( sol) sol( si)
  si4 la si r
  R1
  
  R1 * 2
  r4 re2 do8 do
  si4 do8( la) mi'8( re) do4
  re4 re re8 do si la
  si2. mi8 re
  do8 si la2 re8 do
  si8 la sol2 do8 si
  la8 sol fad( sol) la si do la
  re4 do re mi
  re2 ( ~ re8 do si do)
  si1
  
  \bar "|."
}