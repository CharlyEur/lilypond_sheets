trombone = \relative do {
  % p1
  mi8 mi mi4 mi8 mi mi4
  do8 do do do ~ do2 \breathe
  do8 do do4 dod dod
  
  do8 do do re ~ re2 \breathe
  re8 mi4 re8 mi fa4 mi8
  si8 do re re ~ re2
  r8 re4 dod8 re dod re4
  
  re4 si8 si ~ si4 r
  mi8 mi mi4 mi8 mi mi4
  do8 do do do ~ do2 \breathe
  do8 do do4 dod dod
  
  % p2
  do8 do do re ~ re2 \breathe
  re8 do4 re8 mi fa4 mi8
  si8 do re re ~ re2
  r8 re4 re8 re4 do8 mi ~
  
  mi2. \breathe mi8 mi
  la4. la8 ~ la4 la8 la
  lab4. lab8 ~ lab4 lab
  sol4 sol fa mi8 do ~
  do2 r4 mi8 mi
  
  la4. la8 ~ la4 la8 la
  lab4. lab8 ~ lab2
  r8 sol8 sol4 la8 sol fa fa
  sol8 fa4 re8 ~ re8 sol, la si
  
  % p3
  mi8 mi mi4 mi8 mi mi4
  do8 do do do ~ do2 \breathe
  do8 do do4 dod dod
  do4.( re8 ~ re2) \breathe
  
  fa4 la8 la la la la la
  lab8 lab lab lab ~ lab2
  r8 fa4 fa8 sol la sol4
  mi2.. r8
  
  r8 do4 la8 si la sol4
  r8 do4 la8 si si sol4
  r8 fa'4 fa8 re mi re4
  mi1
  
  \bar "|."
}