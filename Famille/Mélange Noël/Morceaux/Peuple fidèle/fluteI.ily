fluteI = \relative do'' {
  % p1
  sol2 re4 sol
  la2 re,
  si'4 la si do
  si2 la4 sol
  sol2 fad4 mi
  fad4 sol la si8 sol
  
  fad2 mi
  re2. r4
  re'2 do4 si
  do2 si
  la4 si sol la
  sol4 fad8 mi re4 sol
  sol4 fad sol la
  
  %p2
  sol2 re4 si'
  si4 la si do
  si2 la4 si
  do4 si la sol
  fad2 sol4 do
  si2 la4. sol8
  sol2. r4
  
}