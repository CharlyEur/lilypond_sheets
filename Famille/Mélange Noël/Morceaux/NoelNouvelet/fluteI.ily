fluteI = \relative do'' {
  r2 * 4
  sol8 \mf re' mi do
  re4 sib
  do8 do16( re) sib8 la
  sol2
  
  sol8 \p (re') mi do
  re4 sib
  do8 do16( re) sib8 la
  sol2
  
  sib4 \mf la8 sol
  la4. re,8
  sib'8 sib la sol
  la2
  
  sol8 \f (re') mi do
  re4 sib
  do8 do16( re) sib8 la
  sol2
  
  \bar "|."
}