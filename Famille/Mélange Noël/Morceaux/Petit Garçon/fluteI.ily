fluteI = \relative do' {
  \partial 2. re4 sol la
  si2. do8 si
  la2 r8 do si la
  sol2 mi8 mi sol sol
  la2 r8 re, sol la
  
  si2 si8 re do si
  do2 r8 sol sol la 
  si8 si si sol la la la fad
  sol4 r8 si si4 re
  
  \repeat volta 2
  {
    re2. (do4)
    la4. re,8 re fad la re
    do4( si8 la sol4 la)
    si2. sol8 la
    
    si2. sol8 fad
    mi4 si'8 si la4 la8 mi
    la8 la la mi fad4 mi
    re4 \breathe re sol la
    
    si2 r8 si do si
    la2 r8 do si la
    sol2 r8 mi la sol
    la2 r8 re, sol la
    
    si2 si8 re do si
    do2 r8 sol sol la 
    si8 si si sol la la la fad
  }
  \alternative
  {
    {sol4. si8 si4 re}
    {sol,1 \fermata}
  }
    
  \bar "|."
}