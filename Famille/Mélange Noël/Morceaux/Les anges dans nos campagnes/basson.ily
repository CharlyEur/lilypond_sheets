basson = \relative do' {
  R1
  r2 r4 sol ~
  sol4 fad mi mi8( fad)
  fad4 re sol r
  
  R1
  r2 r4 sol ~
  sol4 fad fad8( mi) mi( si)
  do4 re sol r4 \bar "||"
  R1 * 6
  
  r2 sol2
  la8 sol fad mi fad2
  sol8 fad mi re mi2
  fad8 mi re mi fad sol la fad
  si8 do si la sol4 do,
  re4( sol8 si re2)
  sol,1
  
  \bar "|."
}