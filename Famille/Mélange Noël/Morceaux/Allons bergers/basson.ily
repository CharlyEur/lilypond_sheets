basson = \relative do {
  % p1
  re4 re la' fad
  fad4 fad re2
  re4 la re sol,
  
  la2 re
  re4 re la fad
  la4 la re2
  re4 la si la
  
  % p2
  la2 re
  re4 re la mi'
  re4 mi la,2
  re4 re re re
  
  la4 la re2
  R1 * 2
  
  % p3
  r4 re8 re re4 re
  sol,8 la si dod re2
  
  si4 la re sol,
  la2 re
  
}