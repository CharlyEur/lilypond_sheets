tuba = \relative do {
  si4-. si-. do-. re-.
  mi4_\markup { \italic simile } mi fad2
  sol4 sol sol fad
  mi2-> sol->
  re1 ->
  
  sol,4 si mi, re
  sol4 si re8 do si la
  sol4 si do re
  do8 si la4 sol2
  sol4 si mi, re
  
  sol4 si re8 do si la
  sol4 si do re
  do8 si la4 sol2
  si4 do re re,
  sol4 la si8 la sol si
  do4 si do re
  
  do8 si la4 sol2
  sol4 sol do re
  mi4 si re8 do si la
  si4 do re re,
  mi8( fad sol4) do8( si la4)
  sol1 ->
  
  \bar "|."
}