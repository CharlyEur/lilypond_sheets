basson = \relative do {
  % p1
  R1
  r4 re8 si mi si mi,4
  mi8 si' sol'4 la,8 mi' sol4
  re,8 re' mi fad sol sol, fad4
  
  mi8 si' sol'4 la,8 mi' la4  
  lad8 fad do4 si si
  mi,8 si' mi4 la,8 mi' sol4
  re,8 re' mi fad sol, fa mi4
  
  la8 mi' sol4 mi,8 si' sol'4
  fad,4 si, mi8 lab, sol4
  do8 do'4 do8 do, do'4 do8
  do,8 do'4 do8 do, do'4 do8
  
  % p2
  do,8 do'4 do8 do, do'4 do8
  do,8 do'4 do8 do do, re mi
  fa8 do' la'4 mi,8 si' mi4
  mib4 re r8 re sol,4
  
  la8 mi' la do mi do si4
  do8 do, re si mi si mi,4
  mi8 si' sol'4 la,8 mi' la4
  re,,8 la' mi' fad sol sol, fad4
  
  mi8 si' sol'4 la,8 mi' la4
  lad8 fad do4 si si
  mi,8 si' mi4 la,8 mi' sol4
  re,8 re' mi fad sol, fa mi4
  
  % p3
  la8 mi' sol4 mi,8 si' sol'4
  fad,4 si, mi8 lab, sol4
  do8 do'4 do8 do, do'4 do8
  do,8 do'4 do8 do, do'4 do8
    
  do,8 do'4 do8 do, do'4 do,8
  do8 do'4 do8 do do, re mi
  fa8 do' la'4 mi,8 si' mi4
  mib4 re r8 re sol,4
  la8 mi' la do mi do si4
  do8 do, re si mi re do r
  
  \modulation
  
  fa,8 do' lab'4 sib,8 fa' sib4
  mib,,8 sib' fa' sol lab lab, sol4
  
  % p4
  fa8 do' lab'4 sib,8 fa' sib4
  si8 sol reb4 do do
  fa,8 do' lab'4 sib,8 fa' lab4
  mib,8 mib' fa sol lab, solb fa4
  
  sib8 fa' lab4 fa,8 do' lab'4
  reb8 reb, mib reb fa r r4
  sib,8 fa' lab4 fa,8 do' lab'4
  reb8 reb, mib reb fa2 \fermata
  
  
  
  \bar "|."
}