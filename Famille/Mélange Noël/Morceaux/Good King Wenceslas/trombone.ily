trombone = \relative do' {
  R1 * 5
  
  sol4 sol sol la
  sol4 sol re2
  mi4 re mi fad
  sol2 sol
  sol4 sol sol la
  
  sol4 sol re2
  mi4 re mi fad
  sol2 sol
  re'4 do si la
  si4 la sol2
  mi4 re mi fad
  
  sol2 sol
  re4 re mi fad
  sol4 sol la2
  re4 do si la
  sol2 do
  sol1
  
  \bar "|."
}