
trombone = \relative do' {
   sol4. lab8 sib4 lab
   sol4 lab sib sol
   sib8 sib sib sib sib4. sol8
   lab4 lab sol2
   r4 sib2 sib4
   r4 sib2 sib4
   sib2 do2
   sib4 la sib2
   sol4. lab8 sib4 lab
   sol4 lab sib sol
   mib8 mib mib mib mib4. sib'8
   sib4 lab sol2 \fermata
   
   sib4. lab8 sol4 fa
   mib4 fa sol mib
   re4 sib fa' mib
   re4 mib fa2
   sol4 lab sib2 ~
   sib4 lab mib sol
   do4 sib sol mib' ~
   mib4 re do fa,
   sib4 la sib2
   la4 sol fa2
   mib8 fa sol4 la2
   sib4 lab sol fa
   mib2. fa4
   sol2 sib
   sib2. lab4
   sol2 fa
   mib4 mib mib mib
   fa4 sol lab2
   sib2 lab
   sol1 \fermata
   
  \bar "|."
}