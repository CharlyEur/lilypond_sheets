hautbois = \relative do'' {
  do8 do mi fad sol4 mi
  mi4 re8 do si4. si8
  sol8 sol la si do do r8 do
  la8 la do4 re r8 si
  
  sol8 sol la si do4 do8 do
  dod4 lad la8 do si4
  sol8 sol la si do do r do
  la4 do re8 red re4

  mi2 mi4 si8 si
  mi4 do si8 do si4
  do8. do16 si8 la sol4 sol8 sol
  do8 re do si la sib si re
  
  %p2
  mi8. mi16 mi8 mi mi mi do do
  do4 do8 re mi4 r8 sib
  do8 do fa do sol' fad mi4
  sol4 fad sol r4
  
  do,8 do mi fad sol4 mi
  mi4 re8 do si4 r8 si
  sol8 sol la si do do r do
  la8 la do4 re r8 si
  
  sol8 sol la si do4 do8 do
  dod4 lad la8 do si4  
  sol8 sol la si do do r do
  la4 do re8 red re4
  
  %p3
  mi2 mi4 si8 si
  mi4 do si8 do si4
  do8. do16 si8 la sol4 sol8 sol
  do8 re do si la sib si re
  
  mi8. mi16 mi8 mi mi mi do do
  do4 do8 re mi4 r8 si
  do8 do fa do sol' fad mi4
  sol4 fad sol r4
  
  do,8 do mi fad sol4 mi
  mi4 re8 do mi4 ~ mi8 do
  
  \modulation
  
  fa8 \f fa sol lab lab reb, r8 reb
  sol8 sol lab sib mib,4 r8 do
  fa8 fa sol lab sib4 lab8 sol
  sol4 sol8 fa sol4 r8 do,
  fa8 fa sol lab lab reb, r reb
  sol,8 sol lab sib do do do do
  sib8 lab sol fa lab4 do,8 do
  lab'4 sol8 fa fa4 r8 do'
  sib8 lab sol fa lab4 do,8 do
  lab'4 sol8 fa fa2 \fermata

  \bar "|."
}