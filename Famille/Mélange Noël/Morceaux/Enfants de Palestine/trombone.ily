trombone = \relative do {
  % p1
  la8 mi' la do mi do si4
  do8 do, re fad sol4 r
  r4 sol r la
  r2 sol4 la
  
  r4 sol r la
  lad8 fad do4 red8 mi red4
  r4 mi r sol
  r2 sol8 fa mi4
    
  do'2 si4 sol
  fad4 si, si'8 la sol4
  sol8. la16 sol8 fa mi4 mi8 mi
  la8 si la sol fa fa fa si

  % p2
  do8. do16 do8 do si si la lab
  sol4 sol8 si sib4 r4
  r4 la r8 la sol4
  do4 la r2
  
  la,8 mi' la do mi do si4
  do8 do, re fad sol4 r
  r4 sol r la
  r2 sol4 la
  
  r4 sol r la
  r2 red,8 mi red4
  r4 mi r sol
  r2 sol8 fa mi4
  
  % p3
  r4 sol si sol
  lad4 la sol8 fad fa4
  sol8. la16 sol8 fa mi4 mi8 mi
  la8 si la sol fa fa fa si
  
  do8. do16 do8 do si si la lab
  sol4 sol8 si sib4 r
  r4 la r8 la sol4
  do4 la r2
    
  la,8 mi' la do mi do si4
  do8 do, re fad sol4. r8
  
  \modulation
  
  r4 lab r sib
  r4 sib r sib

  % p4
  r4 lab r sib
  r4 reb, mi8 fa mi4
  r4 lab r lab
  r2 lab8 solb fa4
  
  reb2 do4 lab'
  reb8 reb, mib lab lab4 r
  r4 lab r lab
  reb8 reb, mib lab lab2 \fermata

  \bar "|."
}