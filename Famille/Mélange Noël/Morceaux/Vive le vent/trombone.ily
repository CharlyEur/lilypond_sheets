trombone = \relative do' {
  si8 si do si si4 r8 si16 si
  si8 si do si do4 r8 sol
  
  sol8 sol sol do do4 r8 do16 do
  do8 si la re re4 r8 si
  si8 si do si si4 r8 si16 si
  
  si8 si do si do4 r8 sol
  sol8 sol sol do do do la la
  do8 si la do si4. r8
  
  re8 re re4 re8 re re4
  re8 si si8. do16 re4. r8
  sol,8 sol sol8. sol16 sol8 sol sol si
  dod8 dod dod dod re4 do
  re8 re re4 re8 re re4
  re8 si si8. do16 re4. r8
  
  sol,8 sol sol8. sol16 sol8 sol sol si
  re8 re la do si4. r8
  re,8 re fad sol si2 \fermata
  
  \bar "|."
}