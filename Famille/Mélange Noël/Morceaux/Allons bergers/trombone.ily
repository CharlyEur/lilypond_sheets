trombone = \relative do' {
  % p1
  la4 la la la
  la4 la la2
  la4 la la si
  
  sol2 fad
  la4 la la la
  la4 la la2
  la4 la la si
    
  % p2
  sol2 fad
  la4 la la la
  sold4 sold mi2
  re4 re re re
  
  mi4 mi fad2
  R1 * 2
  
  % p3
  r4 la,8 la la4 la
  re2 re
  
  la4 la la si
  sol2 fad
    
  \bar "|."
}