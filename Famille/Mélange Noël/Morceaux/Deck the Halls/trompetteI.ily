trompetteI = \relative do'' {
  sib4. lab8 sol4 fa
  mib4 fa sol mib
  fa8 sol lab fa sol4. fa8
  mib4 re mib2
  
  fa4. sol8 lab4 fa
  sol4. lab8 sib4 fa
  sol8 la sib4 do8 re mib4
  re4 do sib2
  sib4. lab8 sol4 fa
  mib4 fa sol mib
  do'8 do do do sib4. lab8
  sol4 fa mib2 \fermata

  R1 * 6
  
  mib'4. re8 do4 sib
  la8 sib do re mib4 do
  re4 do sib2
  do4 sib lab2
  sol2 mib
  sib'1

  sib4. lab8 sol lab sol fa
  mib8 re mib fa sol fa mib sol
  fa8 mib fa sol lab sol fa lab
  sol8 lab sol fa sol lab sib sol
  do4 do do do
  sib2. lab4
