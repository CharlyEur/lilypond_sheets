hautbois = \relative do' {
  do8 do mi fad sol4 mi
  mi4 re8 do si4. si8
  sol8 sol la si do do r8 do
  la8 la do4 re r8 si
  
  sol8 sol la si do4 do8 do
  dod4 lad la8 do si4
  sol8 sol la si do do r do
  la4 do re8 red re4

  mi2 mi4 si8 si
  mi4 do si8 do si4
  do8. do16 si8 la sol4 sol8 sol
  do8 re do si la sib si re
  
  %p2
  mi8. mi16 mi8 mi mi mi do do
  do4 do8 re mi4 r8 si
  do8 do fa do sol' fad mi4
  sol4 fad sol r4
  
  do,8 do mi fad sol4 mi
  mi4 re8 do si4 r8 si
  sol8 sol la si do do r do
  la8 la do4 re r8 si
  
  sol8 sol la si do4 do8 do
  dod4 lad la8 do si4  
  sol8 sol la si do do r do
  la4 do re8 red re4
  
  %p3
  mi2 mi4 si8 si
  mi4 do si8 do si4
  do8. do16 si8 la sol4 sol8 sol
  do8 re do si la sib si re
  
  mi8. mi16 mi8 mi mi mi do do
  do4 do8 re mi4 r8 si
  do8 do fa do sol' fad mi4
  sol4 fad sol r4
  
  do,8 do mi fad sol4 mi
  mi4 re8 do mi4 ~ mi8 do
  
  \modulation
  
  lab8 lab sib do reb reb r reb
  sib4 reb mib r4
  
  %p4
  lab,8 lab sib do reb4 reb8 reb
  r1
  r8 lab sib do reb reb r reb
  r2 lab8 sib do do
  
  fa2 fa4 do8 do
  fa4 mib8 reb do2
  fa2 fa4 do8 do
  fa4 mib8 reb do2 \fermata

  \bar "|."
}