fluteTenor = \relative do' {
  \repeat volta 2
  {
    re4 sol sol sol8 si
    la8 sol fad mi re2
    si4 si8 do re4 mi8 mi
    mi8 fad mi re dod4 re
    
    re4 sol sol sol8 si
    la8 sol fad mi re2
    si'4 do sol sol8 sol
    sol4 fad8 mi re2
    
    %p2
    sol8 fad mi fad re sol la4
    la8( sol fad4) sol( la)
    sol2 ~ sol8 fad mi fad
    sol8 la sol4 sol fad
    
    re8 sol fad mi re sol sol4
    la8( sol fad4) sol( la)
    sol8 fad sol la si la si4
    la4( sol) fad2
  }
    
  \bar "|."
}