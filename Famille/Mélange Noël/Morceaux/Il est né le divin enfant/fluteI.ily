fluteI = \relative do' {
  \repeat volta 2
  {
    re4 sol sol si8 sol
    re4 sol sol2
    sol4 sol8 la si4 do8 si
    la4 sol la la-.
    
    re,4 sol sol si8 sol
    re4 sol sol2
    si4 do re mi8 do
    si4 la sol2
    
    %p2
    si4 do re do8 si
    do4 mi re2
    si4 do re mi8 re
    do4 si si la
    si4 do re do8 si 
    do4 mi re2
    si4 do re mi8 re
    do4 si la2
  }
    
  \bar "|."
}