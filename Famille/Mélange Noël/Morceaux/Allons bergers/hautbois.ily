hautbois = \relative do' {
  % p1
  re4 re dod si
  dod4 dod re2
  re4 dod re si
  
  dod2 re
  re4 dod dod si
  dod4 dod re2
  re4 dod re si
    
  % p2
  re4 dod re2
  fad4 fad mi mi
  re4 re dod2
  fad4 sol fad mi8 re
  
  dod4 dod re re8 mi
  fad4 fad fad re8 mi
    
  % p3
  fad4 fad fad re8 mi
  fad4 re8 mi fad4 fad
  sol2 fad
  
  re4 dod re si
  re4 dod re2
  
  \bar "|."
}