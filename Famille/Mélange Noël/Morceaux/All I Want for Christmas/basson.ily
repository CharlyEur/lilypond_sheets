basson = \relative do {
  % p1
  sol8 si re fad sol fad re si
  sol8 do re sol sol4. la,8
  sol2 \tuplet 3/2 {si4 re fad}
  sol4 fad mi re
  r4 la'4 ~ la8 sol sol fad
  sol4 fad mi re
  
  r4 do8 mi sol4 la8 si ~
  si8 la4 sol8 mi2
  r4 si'8 re la4 sol8 la ~
  la8 sol4 fa8 mib2
  sol4 la fad sol8 mi ~
  mi8 fad4 mi8 red2
  
  si'4 la8 la4 sol mi8 ~
  mi8 fad4 mi8 red2
  r4 re8 mi sol4 re'
  do1 \fermata
  si4 la sol mi
  mib4 \fermata la2 si4
  sol1
  
  \swing
  
  sol4 sol sol sol
  mi4 mi mi mi
  do4 do do do
  r8 re8 re re re re r4
  
  sol,8-- sol-. re'-- re-. sol,-- sol-. re'-- re-.
  sol,_\markup { \italic simile } sol re' re sol, sol re' re
  sol,8 sol re' re sol, sol re' re
  sol,8 re' la re lad re si re
  
  % p2
  
  do,8 do sol' sol do, do sol' sol
  do,8 do sol' sol do, do sol' sol
  mib8 mib do' do mib, mib do' do
  mib,8 mib do' do mib, mib do' do
  
  sol8 sol re' re sol, sol re' re
  sol,8 sol re' re sol, sol re' re
  sol,8 sol re' re sol, sol re' re
  sol,8 re' la re lad re si re
  
  do,8 do sol' sol do, do sol' sol
  do,8 do sol' sol do, do sol' sol
  mib8 mib do' do mib, mib do' do
  mib,8 mib do' do mib, mib do' do
 
  re,8 re si' si re, re si' si
  re,8 re si' si red, red si' si
  mi,8 mi si' si mi, mi si' si
  mi,8 mi si' si mib, mib si' si
  
  re,8 re si' si re, re si' si
  mi,8 mi si' si mi, mi si' si
  do,8 do sol' sol do, do sol' sol
  mib8 mib do' do mib, mib do' do
  
  \repeat volta 2 {
    sol8 sol re' re sol, sol re' re
    mi,8 mi si' si mi, mi si' si
    do,8 do sol' sol do, do sol' sol
    
    
  % p3
    r8 re'8 re re re re re4
    sol,8 sol re' re sol, sol re' re
    sol,8 sol re' re sol, sol re' re
    sol,8 sol re' re sol, sol re' re
    sol,8 re' la re lad re si re
    
    do,8 do sol' sol do, do sol' sol
    do,8 do sol' sol do, do sol' sol
    mib8 mib do' do mib, mib do' do
    mib,8 mib do' do mib, mib do' do
    
    sol8 sol re' re sol, sol re' re
    sol,8 sol re' re sol, sol re' re
    sol,8 sol re' re sol, sol re' re
    sol,8 re' la re lad re si re
    
    do,8 do sol' sol do, do sol' sol
    do,8 do sol' sol do, do sol' sol
    mib8 mib do' do mib, mib do' do
    mib,8 mib do' do mib, mib do' do
        
    re,8 re si' si re, re si' si
    re,8 re si' si red, red si' si
    mi,8 mi si' si mi, mi si' si
    mi,8 mi si' si mib, mib si' si
      
    re,8 re si' si re, re si' si
    mi,8 mi si' si mi, mi si' si
    do,8 do sol' sol do, do sol' sol
    mib8 mib do' do mib, mib do' do
    
  % p4
    sol8 sol re' re sol, sol re' re
    mi,8 mi si' si mib, mib si' si
    do,8 do sol' sol do, do sol' sol
    
    re8 re la' la re, re la' la
    si8 si fad' fad si, si fad' fad
    si,8 fad' la, fad' sol, fad' fad, fad'
    mi,8 mi si' si mi, mi si' si
    
    mi,8 mi si' si mi, mi si' si
    si8 si fad' fad si, si fad' fad
    si,8 fad' la, fad' sol, fad' fad, fad'
    mi,8 mi si' si mi, mi si' si
    
    mi,8 mi si' si mi, mi si' si
    mib,8 mib sib' sib mib, mib sib' sib
    mib,8 mib sib' sib mib, mib sib' sib
    sol8 sol re' re sol, sol re' re
    
    sold,8 sold mi' mi sold, sold mi' mi
    la,8 la mi' mi la, la mi' mi
    la,8 la mi' mi la, la mi' mi
    re,8 re la' la re, re la' la
    
    re,8 re la' la re, re la' la
    sol8 sol re' re sol, sol re' re
    sol,8 sol re' re sol, sol re' re
    sol,8 sol re' re sol, sol re' re
    sol,8 re' la re lad re si re
    
    % p5
    do,8 do sol' sol do, do sol' sol
    mi8 mi si' si mi, mi si' si
    mib,8 mib do' do mib, mib do' do
    mib,8 mib do' do mib, mib do' do
    
    re,8 re si' si re, re si' si
    re,8 re si' si red, red si' si
    mi,8 mi si' si mi, mi si' si
    mi,8 mi si' si mib, mib si' si
    
    
    re,8 re si' si re, re si' si
    mi,8 mi si' si mi, mi si' si
    do,8 do sol' sol do, do sol' sol
    mib4 mib2( mib4
    mib4 mib2 mib4)
    r8 re' re re re re re4
    sol,8 sol re' re sol, sol re' re
  
  }
  \repeat volta 2
  {
    do,8 do sol' sol do, do sol' sol
    re8 re la' la re, re la' la
    sol8 sol re' re sol, sol re' re
    mi,8 mi si' si mi, mi si' si
  }
  
  \bar "|."
}