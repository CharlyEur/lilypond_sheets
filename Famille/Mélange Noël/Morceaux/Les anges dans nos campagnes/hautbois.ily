hautbois = \relative do'' {
  sol4 sol sol sol8( si)
  si4 fad sol8( mi) re4
  sol4 sol sol8( fad) mi( re)
  re4 fad sol r
  
  sol4 sol sol sol8( si)
  si4 fad sol8( mi) re4
  re4 red red8( mi) sol( fad)
  mi4 fad re r
  r2 sol
  
  la8 sol fad mi fad2
  sol8 fad mi re mi4. mi8
  fad8 mi re mi fad sol la fad
  re4 mi8 fad sol4 la4 ~
  la4 sol2 fad4
  si8 la sol fad mi2 ~
  mi4 la8 sol fad mi re4 ~
  re4 sol8 fad mi re do4 ~
  do8 dod re( dod) re mi fad re
  re4 fad sol la ~
  la4 sol2 fad4
  re1
  
  \bar "|."
}