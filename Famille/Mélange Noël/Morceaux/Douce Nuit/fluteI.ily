fluteI = \relative do'' {
  sol8. la16 sol8 mi4.
  sol8. la16 sol8 mi4.
  re'4 ~ re16 si si4.
  do4 ~ do16 sol sol4.
  
  la4 la8 do8. si16 la8
  sol8. la16 sol8 mi4.
  la4 la8 do8. si16 la8
  sol8. la16 sol8 mi4.
  
  re'4 re8 fa8. re16 si8
  do4. mi4 r8
  do8. sol16 mi8 sol8. fa16 re8
  do2.
  
  \bar "|."
}