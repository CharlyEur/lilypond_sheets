trombone = \relative do {
  % p1
  \partial 4 r4
  R2. * 10
  do4 do8 re do sib
  
  do2 r4
  re4 re8 mib re re
  sib4 sib sib
  sib2 do4
  re4 r2
  R2. * 2
  do4 do8 re do sib
  do4 do do
  re4 re8 mib re re
  sib4 sib sib
  sib2 do4
  
  re4 r2
  R2. * 3
  do4 do do
  re4 re re
    
  % p2
  R2.
  sib4 do do
  re4 r2
  R2. * 2
  do4 do8 re do sib
  do4 do do
  re4 re8 mib re re
  sib4 sib sib
  sib2 do4
  sib4 r2
  R2. * 2
  sol'4 fa sol
  la4 la la
  re4 re re
  R2.
  sib,4 do do
  re4 r2
  R2. * 2
  do4 do8 re do sib
  do4 do do
  re4 re8 mib re re
  sib4 sib sib
  sib4 do do
  sib4 r2
  re16 fa sib re r2
  r4 fa,2 ~
  fa2.
}