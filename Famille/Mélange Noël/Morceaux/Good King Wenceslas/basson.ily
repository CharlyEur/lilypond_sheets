basson = \relative do {
  re4-. re-. mi-. fad-.
  sol4-. sol-. la2-.
  re4_\markup { \italic simile } do si la
  sol2-> do->
  sol1->
  
  \bar "||"
  
  re4 re mi fad
  re4 re la2
  do4 si do re
  mi2 re
  re4 re mi fad
  
  re4 re la2
  do4 si do re
  mi2 re
  sol4 la sol fad
  sol4 fad mi2
  do4 si do re
  
  mi2 re
  si4 si do re
  mi4 mi fad2
  sol4 sol sol fad
  mi2 sol
  re1
  
  \bar "|."
}