fluteI = \relative do'' {
  % p1  
  la2 si
  \tuplet 3/2 {do4 la fa} \tuplet 3/2 {si4 sol mi}
  \tuplet 3/2 {la4 fa re} \tuplet 3/2 {la'4 sol r}
  \tuplet 3/2 {do4 la fa} \tuplet 3/2 {si4 sol mi}
  \time 2/4
  \tuplet 3/2 {la4 fa re}
  \time 4/4
  \tuplet 3/2 {la'4 sol2} r2

  mi4 mi mi mi8 mi ~
  mi2 r8 la4 si8
  do4 do \tuplet 3/2 {do4 si la}
  sol2. r4 \bar "||"
  sol8 la4 sol8 mi4 do'4
  la4 sol2 r4
  
  sol8 la sol la sol4 do
  si2. r4
  fa8 sol4 fa8 re4 si'
  la4 sol2 r4
  sol8 la sol la sol4 la
  mi2. r4
  
  sol8 la4 sol8 mi4 do'
  la4 sol r2
  sol8 la sol la sol4 do
  si2. r4
  fa8 sol4 fa8 re4 si'
  la4 sol2 r4
  
  % p2
  sol8 la sol la sol4 re'
  do2. r4 \bar "||"
  la4 la do8 la ~ la4
  sol4 mi8 sol ~ sol2
  fa4 la sol fa8 mi ~
  mi2. r4
  
  re2 mi4 fad
  re4 mi8 sol ~ sol4 r
  la4 la fad fad
  sol4 re8 sol ~ sol4 r
  sol8 la4 sol8 mi4 do'
  la4 sol2 r4
  
  sol8 la sol la sol4 do
  si2. r4
  fa8 sol4 fa8 re4 si'
  la4 sol2 r4
  sol8 la sol la sol4 re'
  do2 r
  
  \bar "|."
}