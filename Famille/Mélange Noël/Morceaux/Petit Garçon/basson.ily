basson = \relative do {
  \partial 2. re4 sol fad
  sol2. fad8 sol
  fad2 r8 fad sol la
  mi2 do8 do mi do
  fad2 r8 re sol fad
  
  sol2 re8 sol la sol
  mi2 r8 mi mi mi
  re8 sol sol sol fad re do re
  sol4 r8 sol sol4 sol
  
  la2.( sol4)
  fad4. re8 re re fad fad
  mi2( do4 mi)
  sol2. sol8 fad
  mi2. mi8 re
  mi4 mi8 mi mi4 mi8 si
  dod8 la dod la re4 dod
  re4 \breathe re sol fad
  sol2 r8 fad fad sol
  fad2 r8 fad sol la
  mi2 r8 do do mi
  fad2 r8 re sol fad
  sol2 re8 sol la sol
  mi2 r8 mi mi mi
  re8 sol sol sol fad re do re
  sol4. sol8 sol4 sol
  sol1
  
  \bar "|."
}