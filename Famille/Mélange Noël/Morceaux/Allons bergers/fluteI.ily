fluteI = \relative do' {
  % p1
  fad4 fad mi re
  la'4 la fad2
  fad4. mi8 fad4 sol
    
  mi2 re
  fad4 fad mi re
  la'4 la fad2
  la4. re,8 sol4 fad
    
  % p2
  mi2 re
  \repeat volta 2
  {
    re'4 re dod dod
    si4 si la2
    la4 si la sol8 fad
    sol4 la fad fad8 sol
    la4 la la fad8 sol
    
    % p3
    la4 la la fad8 sol
    la4 fad8 sol la4 la
    si2 la
    re,4. mi8 fad4 sol
    mi2 re
  }
    
  \bar "|."
}