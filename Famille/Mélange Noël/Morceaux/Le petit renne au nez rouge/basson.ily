basson = \relative do' {
  % p1
  la2 si
  fa2 mi
  re2 do4 r
  re2 mi
  
  \time 2/4  
  fa2
  
  \time 4/4  
  sol2 r
  
  R1
  mi4 re do si
  la4 r8 la re4 fad
  sol4 fa re si
  do4 r8 do sol4 r8 sol
  do4 sol do mi
  
  re4 r8 re dod4 re
  sol,4 la si dod
  re4 r8 re sol,4 r8 re'
  r8 re r sol, ~ sol4 fad
  sol4 la lad si
  do4 si la( si)
  
  do4 r8 do sol4 r8 sol
  do4 sol do mi
  re4 r8 re dod4 re
  sol,8 sol la4 si( dod)
  re4 r8 re sol,4 r8 re'
  r8 re r8 sol, ~ sol4 fad
  
  % p2
  sol4 la lad si
  do4 si la sol \bar "||"
  
  fa4 sol la fa
  do'4 si do mi
  re4 do si sol
  do8 do si4 do4( mi8) r
  
  re4 mi sol la
  si4 si8 si ~ si4 r
  do4 do si la
  sol4 fa8 re ~ re sold, la si
  do4 r8 do sol4 r8 sol
  do4 sol do mi
  
  re4 r8 re dod4 re
  sol,8 sol la4 si( dod)
  re4 r8 re sol,4 r8 re'
  r8 re r sol, ~ sol4 fad
  sol4 sol' sol sol,
  do2 r
  
  \bar "|."
}