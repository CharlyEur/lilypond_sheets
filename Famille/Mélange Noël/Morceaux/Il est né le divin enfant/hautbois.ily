hautbois = \relative do' {
  \repeat volta 2
  {
    re4 re re re8 re
    re4 re re2
    sol4 sol8 la si4 do8 si
    la4 sol fad fad-.
    
    re4 re re re8 re
    re4 re re2
    sol4 la si do8 la
    sol4 fad re2
    
    %p2
    sol4 la si la8 sol
    la4 do si2
    re4 mi sol8 si sol sol
    sol4 mi8 sol sol4 fad
    sol4 la si la8 sol
    la4 do si2
    sol4 sol sol sol8 sol
    sol4 re8 mi fad2
  }
    
  \bar "|."
}