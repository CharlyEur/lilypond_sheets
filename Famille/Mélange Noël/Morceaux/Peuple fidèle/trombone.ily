trombone = \relative do' {
  % p1
  si2 si4 si
  do2 la
  sol4 la sol sol
  sol2 fad4 sol
  sol2 la4 la
  la4 sol fad re
  
  la'2 sol
  fad2. r4
  si2 do4 re
  do2 re
  re4 sol, si do
  si4 la8 sol fad4 r
  R1
  r2 r4 sol
  sol4 fad sol la
  sol2 fad4 re'
  re4 re la la
  la2 sol4 sol
  sol2 fad4. sol8
  sol2. r4
}