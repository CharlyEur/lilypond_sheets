  mib,2 r4 sib'4
  mib,4 sib' mib,2
  lab8 lab lab lab mib2
  
  mib4 sib' mib,2 \fermata
  
  R1 * 4
  
  sib'4. lab8 sol4 fa
  mib4 fa sol mib
  do4 re mib2
  fa2. fa4
  fa2. fa4
  fa2. fa4
  sol8 la sib4 do8 re mib4
  re4 do sib8 lab sol fa
  mib2. re4
  do2 sib
