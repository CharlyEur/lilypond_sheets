trombone = \relative do' {
  % p1
  la2 si
  do2 si
  la2 sol4 r
  la2 sol
  
  \time 2/4  
  la2
  
  \time 4/4  
  do2 r
  
  do4 si la sol8 la ~
  la2 r
  sol4 r fad la
  si4 do8 si ~ si sol r4
  do4 si re mi
  do4 do r do
  
  si8 re si do si4 la
  sol2. r4
  si8 do4 do8 si4 re
  si4 si2 r4
  re8 re si do si4 sol
  sol2. r4
  
  do4 si re mi
  do4 do r do
  si8 re si do si4 la
  sol2. r4
  si8 do4 do8 si4 re
  si4 si2 r4
  
  % p2
  re8 re si do re4 fa
  mi2. r4
  \bar "||"
  
  do4 do re8 do ~ do4
  do4 re8 do ~ do2
  do4 do la la8 sol ~
  sol2. r4
  
  si4 la sol la
  sol4 sol8 si ~ si4 r
  la4 la la la
  sol4 sol8 sol ~ sol4 r
  do4 si re mi
  do4 do2 r4
  
  si8 re si do si4 la
  sol2. r4
  si8 do4 do8 si4 re
  si4 si2 r4
  re8 re si do si4 fa'  
  mi2 r
  
  \bar "|."
}