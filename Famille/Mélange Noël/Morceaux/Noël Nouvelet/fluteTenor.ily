fluteTenor = \relative do' {
  % p1
  R2 * 2
  sol2
  re'8 re16 do sib8 la
  sol4 sol
  sol8 la sib do
  
  do4 sib
  re8 re16 do sib8 la
  sol4 sib8 sib
  re2
  re4. mib8
  re2
  sol,4. la8
  
  fad8 sol la do
  sib4 do
  fad,8 sol la do
  sib4 do
  sol8 la sib do
  do4 sib
  sib2
  
  % p2
  sol8 re' mi do
  re4 sib
  do8 do16 re sib8 la
  sol2
  sol4 sol
  sol8 la sib do
  do4 sib
  
  re4 sol,
  sib4 la8 sol
  la4. re,8
  sib'8 sib la sol
  la4. re,8
  sol8 sol fa mi
  fad2
  
  sib4 do
  r8 re la fad
  sol4 sol
  sol8 la sib do
  do4 sib
  sib2
  
  \bar "|."
}